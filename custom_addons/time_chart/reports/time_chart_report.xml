<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Шаблон PDF отчета -->
    <template id="report_time_chart_document">
        <t t-call="web.external_layout">
            <t t-foreach="docs" t-as="doc">
                <div class="page">
                    <h2>
                        <span t-field="doc.name"/>
                    </h2>
                    
                    <div class="row mt-3">
                        <div class="col-6">
                            <strong>Дата создания:</strong>
                            <span t-field="doc.date_created"/>
                        </div>
                        <div class="col-6">
                            <strong>Количество точек:</strong>
                            <span t-field="doc.line_count"/>
                        </div>
                    </div>

                    <t t-if="doc.description">
                        <div class="row mt-2">
                            <div class="col-12">
                                <strong>Описание:</strong><br/>
                                <span t-field="doc.description"/>
                            </div>
                        </div>
                    </t>

                    <!-- График с использованием Chart.js -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <h4>Графики</h4>
                            <canvas t-att-id="'chart_%s' % doc.id" style="max-height: 300px;"/>
                            
                            <script type="text/javascript">
                                (function() {
                                    var timeData = [<t t-foreach="doc.line_ids" t-as="line"><t t-esc="line.time"/><t t-if="not line_last">,</t></t>];
                                    var powerData = [<t t-foreach="doc.line_ids" t-as="line"><t t-esc="line.power"/><t t-if="not line_last">,</t></t>];
                                    var resistanceData = [<t t-foreach="doc.line_ids" t-as="line"><t t-esc="line.resistance"/><t t-if="not line_last">,</t></t>];
                                    
                                    var ctx = document.getElementById('chart_<t t-esc="doc.id"/>');
                                    if (ctx) {
                                        new Chart(ctx, {
                                            type: 'line',
                                            data: {
                                                labels: timeData,
                                                datasets: [{
                                                    label: 'Мощность (Вт)',
                                                    data: powerData,
                                                    borderColor: 'rgb(75, 192, 192)',
                                                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                                                    yAxisID: 'y',
                                                    tension: 0.1
                                                }, {
                                                    label: 'Сопротивление (Ом)',
                                                    data: resistanceData,
                                                    borderColor: 'rgb(255, 99, 132)',
                                                    backgroundColor: 'rgba(255, 99, 132, 0.2)',
                                                    yAxisID: 'y1',
                                                    tension: 0.1
                                                }]
                                            },
                                            options: {
                                                responsive: true,
                                                maintainAspectRatio: false,
                                                interaction: {
                                                    mode: 'index',
                                                    intersect: false,
                                                },
                                                plugins: {
                                                    legend: {
                                                        position: 'top',
                                                    },
                                                    title: {
                                                        display: true,
                                                        text: 'Временная диаграмма'
                                                    }
                                                },
                                                scales: {
                                                    x: {
                                                        display: true,
                                                        title: {
                                                            display: true,
                                                            text: 'Время (сек)'
                                                        }
                                                    },
                                                    y: {
                                                        type: 'linear',
                                                        display: true,
                                                        position: 'left',
                                                        title: {
                                                            display: true,
                                                            text: 'Мощность (Вт)'
                                                        }
                                                    },
                                                    y1: {
                                                        type: 'linear',
                                                        display: true,
                                                        position: 'right',
                                                        title: {
                                                            display: true,
                                                            text: 'Сопротивление (Ом)'
                                                        },
                                                        grid: {
                                                            drawOnChartArea: false,
                                                        }
                                                    }
                                                }
                                            }
                                        });
                                    }
                                })();
                            </script>
                        </div>
                    </div>

                    <!-- Таблица данных -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <h4>Табличные данные</h4>
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>№</th>
                                        <th>Время (сек)</th>
                                        <th>Мощность (Вт)</th>
                                        <th>Сопротивление (Ом)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.line_ids" t-as="line">
                                        <td><t t-esc="line_index + 1"/></td>
                                        <td><t t-esc="'%.2f' % line.time"/></td>
                                        <td><t t-esc="'%.2f' % line.power"/></td>
                                        <td><t t-esc="'%.2f' % line.resistance"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Статистика -->
                    <div class="row mt-3">
                        <div class="col-12">
                            <h4>Статистика</h4>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Параметр</th>
                                        <th>Минимум</th>
                                        <th>Максимум</th>
                                        <th>Среднее</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Мощность (Вт)</td>
                                        <td><t t-esc="'%.2f' % min(doc.line_ids.mapped('power')) if doc.line_ids else '0.00'"/></td>
                                        <td><t t-esc="'%.2f' % max(doc.line_ids.mapped('power')) if doc.line_ids else '0.00'"/></td>
                                        <td><t t-esc="'%.2f' % (sum(doc.line_ids.mapped('power')) / len(doc.line_ids) if doc.line_ids else 0)"/></td>
                                    </tr>
                                    <tr>
                                        <td>Сопротивление (Ом)</td>
                                        <td><t t-esc="'%.2f' % min(doc.line_ids.mapped('resistance')) if doc.line_ids else '0.00'"/></td>
                                        <td><t t-esc="'%.2f' % max(doc.line_ids.mapped('resistance')) if doc.line_ids else '0.00'"/></td>
                                        <td><t t-esc="'%.2f' % (sum(doc.line_ids.mapped('resistance')) / len(doc.line_ids) if doc.line_ids else 0)"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <!-- Определение отчета -->
    <record id="action_report_time_chart" model="ir.actions.report">
        <field name="name">Временная диаграмма</field>
        <field name="model">time.chart</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">time_chart.report_time_chart_document</field>
        <field name="report_file">time_chart.report_time_chart_document</field>
        <field name="binding_model_id" ref="model_time_chart"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Добавление Chart.js в отчет -->
    <template id="report_time_chart_assets" inherit_id="web.report_assets_common">
        <xpath expr="." position="inside">
            <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"/>
        </xpath>
    </template>
</odoo>
