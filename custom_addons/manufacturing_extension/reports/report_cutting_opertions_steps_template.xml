                                            </tbody>
                                        </table>
                                    </t>
                                </div> -->


                                <!-- Notes cell (60%) -->
                                <!-- <div style="display: table-cell; width: 60%; padding: 8px; vertical-align: top; border-right: 1px solid #dee2e6;"> -->
                                    <t t-if="step.notes">
                                        <div style="background-color: #fff; padding: 6px; border: 1px solid #e0e0e0; border-radius: 2px; min-height: 80px;">
                                            <strong style="color: #495057; font-size: 8pt; display: block; margin-bottom: 4px;">📝 Notes:</strong>
                                            <div style="font-size: 7pt; line-height: 1.4; color: #333;">
                                                <span t-field="step.notes"/>
                                            </div>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div style="color: #999; font-size: 7pt; font-style: italic; padding: 6px;">No notes available</div>
