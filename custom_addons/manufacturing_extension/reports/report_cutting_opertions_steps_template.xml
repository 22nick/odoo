                                    <t t-if="step.tools_ids">
                                        <strong style="color: #495057; font-size: 8pt; display: block; margin-bottom: 4px;">Tools:</strong>
                                        <table>
                                            <thead>
                                                <tr>
                                                    <th style="width: 5%;">#</th>
                                                    <th >Ref.No.</th>
                                                    <th >Name</th>

                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="step.tools_ids" t-as="component">
                                                    <tr>
                                                        <td class="text-center">
                                                            <strong><span t-esc="component_index + 1"/></strong>
                                                        </td>
                                                        <td>
                                                            <strong><span t-field="component.reference_id"/></strong>
                                                        </td>
                                                        <td>
                                                            <span t-field="component.name"/>
                                                        </td>
                                                    </tr>
