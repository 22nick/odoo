<odoo>
<template id="report_cutting_opertions_steps_template">
    <div class="compact-section">
        <div class="section-header">OPERATIONS</div>
        <table class="steps-table">
            <thead>
                <tr>
                    <th style="width: 3%;">#</th>
                    <th style="width: 9%;">Step Name</th>
                    <th style="width: 8%;">Equipment</th>
                    <th style="width: 8%;">Equip. Ref.</th>       
                    <th style="width: 7%;">Performer</th>
                    <th style="width: 8%;">Responsible</th>

                </tr>
            </thead>
            <tbody>
                <t t-foreach="o.cutting_operation_ids" t-as="step">
                    <tr>
                        <td class="text-center">
                            <strong><span t-esc="step_index + 1"/></strong>
                        </td>
                        <td>
                            <strong><span t-field="step.name"/></strong>
                        </td>
                        <td>
                            <span t-field="step.equipment_id"/>
                        </td>
                        <td>
                            <span t-field="step.equipment_reference_id"/>
                        </td>
                        <td>
                            <span t-field="step.performer_id"/>
                        </td>
                        <td>
                            <span t-field="step.responsible_id"/>
                        </td>
                        
                    </tr>
                </t>
            </tbody>
        </table>
        <table class="steps-table">
            <thead>
                <tr>
                    <th style="width: 6%;">Income<br/>kg</th>
                    <th style="width: 6%;">Outcome<br/>kg</th>
                    <th style="width: 9%;">Income<br/>section, mm</th>
                    <th style="width: 9%;">Outcome<br/>section, mm</th>
                    <th style="width: 9%;">Income<br/>length, mm</th>
                    <th style="width: 9%;">Outcome<br/>length, mm</th>
                    <th style="width: 9%;">Approval</th>
                    
                </tr>
            </thead>
            <tbody>
                <t t-foreach="o.cutting_operation_ids" t-as="step">
                    <tr>
                        <td class="text-right">
                            <span t-field="step.income_material_weight"/>
                        </td>
                        <td class="text-right">
                            <span t-field="step.outcome_material_weight"/>
                        </td>
                        <td class="text-right">
                            <span t-field="step.income_material_crosssection"/>
                        </td>
                        <td class="text-right">
                            <span t-field="step.outcome_material_crosssection"/>
                        </td>
                        <td class="text-right">
                            <span t-field="step.income_material_length"/>
                        </td>
                        <td class="text-right">
                            <span t-field="step.outcome_material_length"/>
                        </td>
                        <td class="text-right">
                            <span t-field="step.quality_approval"/>
                        </td>
                    </tr>

                    <tr t-if="step.notes">
                        <td colspan="11" style="padding: 5px;">
                            <div style="display: table; width: 100%; border: 1px solid #dee2e6; background-color: #f8f9fa;">
                                
                                <!-- Tools cell (40%) -->
