<odoo>
<template id="report_machining_opertions_steps_template">
    <table class="steps-table">
        <thead>
            <tr>
                <th style="width: 3%;">#</th>
                <th style="width: 12%;">Step Name</th>
                <th style="width: 10%;">Equipment</th>
                <th style="width: 10%;">Performer</th>
                <th style="width: 8%;">Responsible</th>
                <th style="width: 10%;">Start Date/Time</th>
                <th style="width: 9%;">End Date/Time</th>
                <th style="width: 9%;">Income size</th>
                <th style="width: 9%;">Final size</th>
                <th style="width: 9%;">Income lenght</th>
                <th style="width: 9%;">Final lenght</th>

            </tr>
        </thead>
        <tbody>
            <t t-foreach="o.machining_operation_ids" t-as="step">
                <tr>
                    <td class="text-center">
                        <strong><span t-esc="step_index + 1"/></strong>
                    </td>
                    <td>
                        <strong><span t-field="step.name"/></strong>
                    </td>
                    <td>
                        <span t-field="step.equipment_id"/>
                    </td>
                    <td>
                        <span t-field="step.performer_id"/>
                    </td>
                    <td>
                        <span t-field="step.responsible_id"/>
                    </td>
                    <td class="text-center">
                        <span t-field="step.start_date_time" t-options="{'widget': 'date'}"/>
                    </td>
                    <td>
                        <span t-field="step.income_material_crossection"/>
                    </td>
                    <td>
                        <span t-field="step.outcome_material_crossection"/>
                    </td>
                    <td>
                        <span t-field="step.income_material_length"/>
                    </td>
                    <td>
                        <span t-field="step.outcome_material_length"/>
                    </td>

                </tr>
            </t>
        </tbody>
        
    </table>
    <table class="steps-table">
        <thead>
            <tr>
                <th style="width: 9%;">Quality Resp.</th>
                <th style="width: 10%;">Quality Approver</th>
                <th style="width: 10%;">Desired Dimensions</th>
                <th style="width: 10%;">Measured Dimensions</th>
                <th style="width: 10%;">KSB Form No.</th>
                <th style="width: 10%;">Approval</th>

            </tr>
        </thead>
        <tbody>
            <t t-foreach="o.machining_operation_ids" t-as="step">
                <tr>
                    <td>
                        <span t-field="step.resposible_quality_id"/>
                    </td>
                    <td>
                        <span t-field="step.approver_quality_id"/>
                    </td>
                    <td>
                        <span t-field="step.desired_material_crossection"/>
                    </td>
                    <td>
                        <span t-field="step.measured_material_crossection"/>
                    </td>
                    <td class="text-center">
                        <span t-field="step.ksb_form_no"/>
                    </td>
                    <td class="text-center">
                        <span t-field="step.quality_approval"/>
                    </td>
                </tr>

                <!-- Notes and SVG Layout combined row -->
                <tr t-if="step.notes or step.tools_ids or step.measurement_device_ids">
                    <td colspan="12" style="padding: 5px;">
                        <div style="display: table; width: 100%; border: 1px solid #dee2e6; background-color: #f8f9fa;">
                            
                            <!-- Tools cell (30%) -->
                            <div style="display: table-cell; width: 30%; padding: 8px; vertical-align: top; text-align: left;">
                                <t t-if="step.tools_ids">
                                    <strong style="color: #495057; font-size: 8pt; display: block; margin-bottom: 4px;">Used Tools:</strong>
                                    <table>
                                        <thead>
                                            <tr>
                                                <th style="width: 5%;">#</th>
                                                <th >Ref.No.</th>
                                                <th >Name</th>

                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="step.tools_ids" t-as="component">
                                                <tr>
                                                    <td class="text-center">
                                                        <strong><span t-esc="component_index + 1"/></strong>
                                                    </td>
                                                    <td>
                                                        <strong><span t-field="component.reference_id"/></strong>
                                                    </td>
                                                    <td>
                                                        <span t-field="component.name"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                            </div>

                            <!-- Measurement devices cell (30%) -->
                            <div style="display: table-cell; width: 30%; padding: 8px; vertical-align: top; text-align: left;">
                                <t t-if="step.measurement_device_ids">
                                    <strong style="color: #495057; font-size: 8pt; display: block; margin-bottom: 4px;">Measurement Devices:</strong>
                                    <table>
                                        <thead>
                                            <tr>
                                                <th style="width: 5%;">#</th>
                                                <th >Ref.No.</th>
                                                <th >Name</th>

                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="step.measurement_device_ids" t-as="component">
                                                <tr>
                                                    <td class="text-center">
                                                        <strong><span t-esc="component_index + 1"/></strong>
                                                    </td>
                                                    <td>
                                                        <strong><span t-field="component.reference_id"/></strong>
                                                    </td>
                                                    <td>
                                                        <span t-field="component.name"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                            </div>

                            <!-- Notes cell (60%) -->
                            <div style="display: table-cell; width: 60%; padding: 8px; vertical-align: top; border-right: 1px solid #dee2e6;">
                                <t t-if="step.notes">
                                    <div style="background-color: #fff; padding: 6px; border: 1px solid #e0e0e0; border-radius: 2px; min-height: 80px;">
                                        <strong style="color: #495057; font-size: 8pt; display: block; margin-bottom: 4px;">📝 Notes:</strong>
                                        <div style="font-size: 7pt; line-height: 1.4; color: #333;">
                                            <span t-field="step.notes"/>
                                        </div>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div style="color: #999; font-size: 7pt; font-style: italic; padding: 6px;">No notes available</div>
                                </t>
                            </div>
                            
                        </div>
                    </td>
                </tr>
                
            </t>
        </tbody>
        
    </table>
</template>
</odoo>
