<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report Definition -->
    <record id="action_report_workorder_operations" model="ir.actions.report">
        <field name="name">Workorder Operations Report</field>
        <field name="model">mrp.workorder</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">manufacturing_extension.report_workorder_operations_document</field>
        <field name="report_file">manufacturing_extension.report_workorder_operations_document</field>
        <field name="binding_model_id" ref="model_mrp_workorder"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Workorder Operations - %s' % (object.name or 'N/A')</field>
    </record>

    <!-- QWeb Template -->
    <template id="report_workorder_operations_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            .page {
                                font-size: 9pt;
                                line-height: 1.2;
                            }
                            .compact-section {
                                border: 1px solid #333;
                                padding: 6px;
                                margin-bottom: 8px;
                            }
                            .section-header {
                                background-color: #e9ecef;
                                padding: 4px 8px;
                                margin: -6px -6px 6px -6px;
                                font-weight: bold;
                                font-size: 10pt;
                                border-bottom: 1px solid #333;
                            }
                            .info-table {
                                width: 100%;
                                border-collapse: collapse;
                                margin-bottom: 8px;
                                font-size: 8.5pt;
                            }
                            .info-table td {
                                padding: 3px 5px;
                                border: 1px solid #dee2e6;
                                vertical-align: top;
                            }
                            .info-table td.label-col {
                                width: 28%;
                                background-color: #f8f9fa;
                                font-weight: bold;
                                color: #495057;
                                font-size: 8pt;
                            }
                            .steps-table {
                                width: 100%;
                                border-collapse: collapse;
                                margin-top: 8px;
                            }
                            .steps-table thead th {
                                background-color: #f8f9fa;
                                <!-- color: white; -->
                                padding: 5px 3px;
                                text-align: left;
                                font-weight: bold;
                                color: #495057;
                                font-size: 8pt;
                                border: 1px solid #222;
                                line-height: 1.1;
                            }
                            .steps-table tbody td {
                                padding: 4px 3px;
                                border: 1px solid #dee2e6;
                                font-size: 7.5pt;
                                vertical-align: top;
                            }
                            .steps-table tbody tr:nth-child(even) {
                                background-color: #f8f9fa;
                            }
                            .steps-table tfoot td {
                                padding: 5px 8px;
                                border: 2px solid #333;
                                font-size: 8pt;
                                background-color: #e9ecef;
                            }
                            .badge-sm {
                                display: inline-block;
                                padding: 2px 6px;
                                border-radius: 2px;
                                font-size: 7.5pt;
                                font-weight: bold;
                                color: white;
                            }
                            .text-right {
                                text-align: right;
                            }
                            .text-center {
                                text-align: center;
                            }
                            .notes-section {
                                background-color: #f8f9fa;
                                border: 1px solid #dee2e6;
                                padding: 5px;
                                margin-top: 3px;
                                font-size: 7pt;
                                border-radius: 2px;
                            }
                            .footer-info {
                                margin-top: 12px;
                                padding-top: 6px;
                                border-top: 1px solid #dee2e6;
                                font-size: 7pt;
                                color: #6c757d;
                            }
                            .signature-box {
                                border: 1px solid #dee2e6;
                                padding: 10px;
                                border-radius: 3px;
                            }
                            .signature-line {
                                margin-top: 20px;
                                border-bottom: 1px solid #333;
                                width: 80%;
                            }
                            h1.title {
                                margin: 0;
                                font-size: 18pt;
                            }
                            h3.subtitle {
                                margin: 3px 0 0 0;
                                font-weight: normal;
                                font-size: 12pt;
                                color: #6c757d;
                            }
                        </style>

                        <!-- Header Section -->
                        <div class="text-center">
                            <h1 class="title">WORKORDER REPORT</h1>
                            <h3 class="subtitle">
                                <span t-field="o.name"/>
                            </h3>
                        </div>

                        <!-- Work Order Information -->
                        <div class="compact-section">
                            <div class="section-header">WORK ORDER INFORMATION</div>
                            <table class="info-table">
                                <tr>
                                    <td class="label-col"><div>Work Order:</div></td>
                                    <td><strong><span t-field="o.barcode"/></strong></td>
                                    <td class="label-col"><div>Work Center:</div></td>
                                    <td><span t-field="o.workcenter_id"/></td>
                                </tr>
                                <t t-if="o.operation_type_code not in ('smelting')">
                                    <tr>
                                        <td class="label-col">Component:</td>
                                        <td>
                                            <!-- <span t-esc="'%s / ID: %s / Heat No.: %s' % (o.component_id.name, o.component_reference_no, o.component_id.heat_no)"/> -->
                                            <!-- <span t-field="o.component_id"/> -->
                                            <!-- /   -->
                                            <strong>ID: </strong>
                                            <span t-field="o.component_reference_no"/>
                                            <!-- /   --><br/>
                                            <strong>Heat No.: </strong>
                                            <span t-field="o.component_id.heat_no"/>
                                            
                                        </td>
                                        <td class="label-col">Quantity:</td>
                                        <td>
                                            <span t-field="o.component_qty"/>
                                            <span t-field="o.product_uom_id"/>
                                        </td>

                                    </tr>
                                    <tr>
                                        <td class="label-col">Product:</td>
                                        <td>
                                            <!-- <span t-esc="'%s / ID: %s / Heat No.: %s' % (o.component_id.name, o.component_reference_no, o.component_id.heat_no)"/> -->
                                            <!-- <span t-field="o.product_id"/> -->
                                            <!-- /  -->
                                            <strong>ID: </strong>
                                            <span t-field="o.product_reference_no"/>
                                            <!-- /  --><br/>
                                            <strong>Heat No.: </strong>
                                            <span t-field="o.product_id.heat_no"/>
                                            
                                        </td>
                                        <td class="label-col">Quantity:</td>
                                        <td>
                                            <span t-field="o.qty_production"/>
                                            <span t-field="o.product_uom_id"/>
                                        </td>
                                    </tr>
                                </t>

                                <!-- <tr>
                                    <td class="label-col">Work Center:</td>
                                    <td><span t-field="o.workcenter_id"/></td>
                                    <td class="label-col">Operation:</td>
                                    <td><span t-field="o.operation_id"/></td>
                                </tr> -->
                                <tr>
                                    <td class="label-col">Operation Type:</td>
                                    <td>
                                        <span class="badge-sm" style="background-color: #007bff;">
                                            <span t-field="o.operation_type_id"/>
                                        </span>
                                    </td>
                                    <td class="label-col">State:</td>
                                    <td>
                                        <t t-if="o.state == 'pending'">
                                            <span class="badge-sm" style="background-color: #ffc107; color: #000;">Pending</span>
                                        </t>
                                        <t t-elif="o.state == 'ready'">
                                            <span class="badge-sm" style="background-color: #007bff;">Ready</span>
                                        </t>
                                        <t t-elif="o.state == 'progress'">
                                            <span class="badge-sm" style="background-color: #17a2b8;">In Progress</span>
                                        </t>
                                        <t t-elif="o.state == 'done'">
                                            <span class="badge-sm" style="background-color: #28a745;">Done</span>
                                        </t>
                                        <t t-else="">
                                            <span class="badge-sm" style="background-color: #6c757d;">
                                                <span t-field="o.state"/>
                                            </span>
                                        </t>
                                    </td>
                                </tr>
                            </table>

                            <!-- Operation Parameters -->
                            <t t-if="o.operation_type_code == 'forging'">
                                <div class="compact-section">
                                    <div class="section-header">Operation Parameters</div>
                                    <table class="info-table">
                                        <tr>
                                            <td class="label-col">Order Dimensions:</td>
                                            <td><span t-field="o.forging_operation_params_id.order_dimensions"/> mm</td>
                                            <td class="label-col">Start Temperature:</td>
                                            <td><span t-field="o.forging_operation_params_id.start_temperature"/> oC</td>
                                        </tr>
                                        <tr>
                                            <td class="label-col">Lubtication</td>
                                            <td><span t-field="o.forging_operation_params_id.lubtication"/></td>
                                            <td class="label-col">End Temperature:</td>
                                            <td><span t-field="o.forging_operation_params_id.end_temperature"/> oC</td>
                                        </tr>
                                    </table>
                                </div>
                            </t>



                            <!-- Operation Notes -->
                            <t t-if="o.operation_notes">
                                <div style=": table-cell; width: 100%; padding: 8px; vertical-align: top; border-right: 1px solid #dee2e6;">
                                    <div style="background-color: #fff; padding: 6px; border: 1px solid #e0e0e0; border-radius: 2px; min-height: 80px;">
                                        <strong style="color: #495057; font-size: 8pt; display: block; margin-bottom: 4px;">📝 Notes:</strong>
                                        <div style="font-size: 7pt; line-height: 1.4; color: #333;">
                                            <span t-field="o.operation_notes"/>
                                        </div>
                                    </div>
                                </div>
                            </t>
                                
                        </div>

                        

                        <!-- Operations Steps -->
                        <!-- <div class="compact-section"> -->
                            <!-- <div class="section-header">OPERATIONS</div> -->

                            <!-- Cutting Operations Steps -->
                            <t t-if="o.cutting_operation_ids">
                                <t t-set="ek_form_no" t-value="'FR.87 EK-1'"/>
                                <t t-call="manufacturing_extension.report_cutting_opertions_steps_template">
                                    <!-- <t t-set="o" t-value="o"/> -->
                                </t>
                            </t>

                            <!-- Heating Operations Steps -->
                            <t t-if="o.heating_operation_ids">
                                <t t-set="ek_form_no" t-value="'FR.87 EK-6'"/>
                                <t t-call="manufacturing_extension.report_heating_opertions_steps_template">
                                    <t t-set="o" t-value="o"/>
                                </t>
                            </t>

                            <!-- Grinding Operations Steps -->
                            <t t-if="o.grinding_operation_ids">
                                <t t-set="ek_form_no" t-value="'FR.87 EK-8'"/>
                                <t t-call="manufacturing_extension.report_grinding_opertions_steps_template">
                                    <t t-set="o" t-value="o"/>
                                </t>
                            </t>

                            <!-- Forgıng Operations Steps -->
                            <t t-if="o.forging_operation_ids">
                                <t t-set="ek_form_no" t-value="'FR.87 EK-14'"/>
                                <t t-call="manufacturing_extension.report_forging_opertions_steps_template">
                                    <t t-set="o" t-value="o"/>
                                </t>
                            </t>

                            <!-- Machining Operations Steps -->
                            <t t-if="o.machining_operation_ids">
                                <t t-set="ek_form_no" t-value="'FR.87 EK-15'"/>
                                <t t-call="manufacturing_extension.report_machining_opertions_steps_template">
                                    <t t-set="o" t-value="o"/>
                                </t>
                            </t>

                            <!-- Smelting Operations Steps -->
                            <t t-if="o.smelting_operation_ids">
                                <t t-set="ek_form_no" t-value="'FR.87 EK-2'"/>
                                <t t-call="manufacturing_extension.report_smelting_opertions_steps_template">
                                    <t t-set="o" t-value="o"/>
                                </t>
                            </t>

                        <!-- </div> -->

                        <!-- Signature Section -->
                        <t t-if="o.operation_type_code not in ('smelting')">
                            <t t-set="more_col_no" t-value="o.operation_type_code in ('heating', 'machining')"/>
                            <div class="row" style="margin-top: 10px;">
                                <div t-att-class="'col-3' if more_col_no else 'col-4'">
                                    <div class="compact-section">
                                        <div class="section-header">OPERATOR</div>
                                        <div style="padding: 15px 5px 5px 5px;">
                                            <div style="border-bottom: 1px solid #333; margin-bottom: 3px;"></div>
                                            <div style="font-size: 7pt; color: #6c757d;">Signature / Date</div>
                                        </div>
                                    </div>
                                </div>
                                <div t-att-class="'col-3' if more_col_no else 'col-4'">
                                    <div class="compact-section">
                                        <div class="section-header">SUPERVISOR</div>
                                        <div style="padding: 15px 5px 5px 5px;">
                                            <div style="border-bottom: 1px solid #333; margin-bottom: 3px;"></div>
                                            <div style="font-size: 7pt; color: #6c757d;">Signature / Date</div>
                                        </div>
                                    </div>
                                </div>
                                <div t-att-class="'col-3' if more_col_no else 'col-4'">
                                    <div class="compact-section">
                                        <div class="section-header">QUALITY CONTROL</div>
                                        <div style="padding: 15px 5px 5px 5px;">
                                            <div style="border-bottom: 1px solid #333; margin-bottom: 3px;"></div>
                                            <div style="font-size: 7pt; color: #6c757d;">Signature / Date</div>
                                        </div>
                                    </div>
                                </div>
                                <t t-if="more_col_no">
                                    <div class="col-3">
                                        <div class="compact-section">
                                            <div class="section-header">QUALITY APPROVER</div>
                                            <div style="padding: 15px 5px 5px 5px;">
                                                <div style="border-bottom: 1px solid #333; margin-bottom: 3px;"></div>
                                                <div style="font-size: 7pt; color: #6c757d;">Signature / Date</div>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                                
                            </div>
                        </t>

                        <!-- Footer -->
                        <div class="footer-info">
                            <table style="width: 100%;">
                                <tr>
                                    <td style="width: 50%;">
                                        <strong>Company:</strong> <span t-field="o.company_id"/>
                                    </td>
                                    <td style="width: 50%; text-align: right;">
                                        <strong>Generated:</strong> 
                                        <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2" style="padding-top: 3px; text-align: right;">
                                        <t t-if="o.operation_type_code not in ('smelting')">
                                            <strong><span t-esc="ek_form_no"/></strong>
                                        </t>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>