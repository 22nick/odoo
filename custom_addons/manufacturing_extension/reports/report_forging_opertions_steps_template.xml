<odoo>
<template id="report_forging_opertions_steps_template">
    <div class="compact-section">
        <div class="section-header">OPERATIONS</div>
        <table class="steps-table">
            <thead>
                <tr>
                    <th style="width: 3%;">#</th>
                    <th style="width: 12%;">Step Name</th>
                    <th style="width: 10%;">Equipment</th>
                    <!-- <th style="width: 10%;">Recipe Name</th> -->
                    <!-- <th style="width: 8%;">Charge ID</th> -->
                    <th style="width: 10%;">Operation Date</th>
                    <th style="width: 9%;">Performer</th>
                    <!-- <th style="width: 9%;">Responsible</th> -->
                    <th style="width: 9%;">Quality Resp.</th>
                    <th style="width: 9%;">Dimensions, mm</th>
                    <th style="width: 9%;">Start Temp., oC</th>
                    <th style="width: 9%;">End Temp., oC</th>
                    <th style="width: 10%;">KSB Form No.</th>
                    <th style="width: 10%;">Approval</th>

                </tr>
            </thead>
            <tbody>
                <t t-foreach="o.forging_operation_ids" t-as="step">
                    <tr>
                        <td class="text-center">
                            <strong><span t-esc="step_index + 1"/></strong>
                        </td>
                        <td>
                            <strong><span t-field="step.name"/></strong>
                        </td>
                        <td>
                            <span t-field="step.equipment_id.reference_id"/>
                        </td>
                        <!-- <td>
                            <span t-field="step.recipe_name"/>
                        </td>
                        <td class="text-center">
                            <span t-field="step.charge_id"/>
                        </td> -->
                        <td class="text-center">
                            <span t-field="step.operation_date" t-options="{'widget': 'date'}"/>
                        </td>
                        <td>
                            <span t-field="step.performer_id"/>
                        </td>
                        <!-- <td>
                            <span t-field="step.responsible_id"/>
                        </td> -->
                        <td>
                            <span t-field="step.resposible_quality_id"/>
                        </td>
                        <td>
                            <span t-field="step.step_dimensions"/>
                        </td>
                        <td>
                            <span t-field="step.start_temperature"/>
                        </td>
                        <td>
                            <span t-field="step.end_temperature"/>
                        </td>
                        <td class="text-center">
                            <span t-field="step.ksb_form_no"/>
                        </td>
                        <td class="text-center">
                            <span t-field="step.quality_approval"/>
                        </td>
                    </tr>

                    <!-- Notes and Tools combined row -->
                    <tr t-if="step.notes or step.tools_ids">
                        <td colspan="12" style="padding: 5px;">
                            <div style="display: table; width: 100%; border: 1px solid #dee2e6; background-color: #f8f9fa;">
                                
                                <!-- Tools cell (40%) -->
                                <div style="display: table-cell; width: 40%; padding: 8px; vertical-align: top; text-align: left;">
                                    <t t-if="step.tools_ids">
                                        <strong style="color: #495057; font-size: 8pt; display: block; margin-bottom: 4px;">Tools:</strong>
                                        <table>
                                            <thead>
                                                <tr>
                                                    <th style="width: 5%;">#</th>
                                                    <th >Ref.No.</th>
                                                    <th >Name</th>

                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="step.tools_ids" t-as="component">
                                                    <tr>
                                                        <td class="text-center">
                                                            <strong><span t-esc="component_index + 1"/></strong>
                                                        </td>
                                                        <td>
                                                            <strong><span t-field="component.reference_id"/></strong>
                                                        </td>
                                                        <td>
                                                            <span t-field="component.name"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </t>
                                </div>


                                <!-- Notes cell (60%) -->
                                <div style="display: table-cell; width: 60%; padding: 8px; vertical-align: top; border-right: 1px solid #dee2e6;">
                                    <t t-if="step.notes">
                                        <div style="background-color: #fff; padding: 6px; border: 1px solid #e0e0e0; border-radius: 2px; min-height: 80px;">
                                            <strong style="color: #495057; font-size: 8pt; display: block; margin-bottom: 4px;">📝 Notes:</strong>
                                            <div style="font-size: 7pt; line-height: 1.4; color: #333;">
                                                <span t-field="step.notes"/>
                                            </div>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <div style="color: #999; font-size: 7pt; font-style: italic; padding: 6px;">No notes available</div>
                                    </t>
                                </div>

                                
                                
                            </div>
                        </td>
                    </tr>
                </t>
            </tbody>
        </table>
        <!-- Signature -->
        <div class="row justify-content-end" style="margin-top: 10px;">
            <div class="col-3">
                <div class="compact-section">
                    <div class="section-header">OPERATOR</div>
                    <div style="padding: 5px 5px 5px 5px;">
                        <div><strong><span t-field="o.forging_operation_ids[0].performer_id"/></strong></div>
                        <div style="border-bottom: 1px solid #333; margin-bottom: 3px;"></div>
                        <div style="font-size: 7pt; color: #6c757d;">Signature / Date</div>
                    </div>
                </div>
            </div>
            <div class="col-3">
                <div class="compact-section">
                    <div class="section-header">SUPERVISOR</div>
                    <div style="padding: 5px 5px 5px 5px;">
                        <div><strong><span t-field="o.user_id"/></strong></div>
                        <div style="border-bottom: 1px solid #333; margin-bottom: 3px;"></div>
                        <div style="font-size: 7pt; color: #6c757d;">Signature / Date</div>
                    </div>
                </div>
            </div>
            <div class="col-3">
                <div class="compact-section">
                    <div class="section-header">QUALITY CONTROL</div>
                    <div style="padding: 5px 5px 5px 5px;">
                        <div><strong><span t-field="o.forging_operation_ids[0].resposible_quality_id"/></strong></div>
                        <div style="border-bottom: 1px solid #333; margin-bottom: 3px;"></div>
                        <div style="font-size: 7pt; color: #6c757d;">Signature / Date</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row justify-content-end" style="margin-top: 0px">
            <div class="col-6">
                <div class="compact-section">
                    <strong><span>KSB Form No. (if exist): &#160; &#160;</span></strong>
                
                    <span t-field="o.forging_operation_ids[0].ksb_form_no"/>
                </div>
            </div>
        </div>
        <div class="row justify-content-end">
            <div style="font-size: 7pt; text-align: right">FR.87 EK-14</div>
        </div>
    </div>
</template>
</odoo>
