    <record id="product_form_view_extend" model="ir.ui.view">
        <field name="name">product.form.view.extend</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook//page[1]" position="before">

                <page string="Product parameters" name="forging_parameters" invisible="0">
                    <group name="type_and_shape" string="Type">
                        <field name="product_type_id" />
                    </group>
                    <field name="product_type_properties" nolabel="1" columns="2"/>

                    

                    <group name="dimentions" string="Shape and Size (mm)">

                        <field name="forging_type" />
                        <field name="forging_min_length" invisible="forging_type in ['disk', 'disk_hollow']"/>
                        <field name="forging_max_length" invisible="forging_type in ['disk', 'disk_hollow']"/>
                        <field name="forging_width" invisible="forging_type in ['disk', 'round', 'disk_hollow']"/>
                        <field name="forging_height"  invisible="forging_type in ['round', 'square']"/>
                        <field name="forging_diameter"  invisible="forging_type in ['square', 'rectangle']"/>
                        <field name="forging_diameter_inner" invisible="forging_type!='disk_hollow'"/>

                    </group>
                    
                    <group>
                        <group string="Material" name="material">
                            <field name="forging_material"/>
                            <!-- <field name="slag_data_id"/> -->
                        </group>
                        <group string="Reference No." name="reference_no">
                            <field name="product_reference_no"/>
                            <field name="heat_no"/>
                        </group>
                    </group>
                </page>

                <!-- <t><script>console.log("Custom JavaScript In Student Inherit Views")</script></t> -->
                <!-- <script t-attf-src ="student_inherit_views/static/src/js/product_fiels_validate.js" type ="text/javascript" /> -->


            <!-- <field name="volume" position="replace"> -->
                <!-- <p>Inherited field in form view</p> -->
                <!-- <field name="volume" string="Volume;)" class="oe_inline" style="max-width: 7rem;"/> -->

            </xpath>
        </field>
    </record>


    <record id="product_tree_view_extend" model="ir.ui.view">
        <field name="name">product.tree.view.extend</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="is_favorite" position="after">
                <field name="product_reference_no" decoration-bf="1"/>
            </field>

            <!-- <xpath expr="//notebook//page[1]" position="before">

            </xpath> -->

        </field>
    </record>

    <record id="product_types_list_view" model="ir.ui.view">
        <field name="name">product.types.list.view</field>
        <field name="model">product.types</field>
        <field name="arch" type="xml">
        <list string="Product Types">
            <field name="id"/>
            <!-- <field name="sequence" widget="handle"/> -->
            <field name="name"/>
            <field name="code"/>

        </list>
        </field>
    </record>

    <record id="product_types_form_view" model="ir.ui.view">
        <field name="name">product.types.form.view</field>
        <field name="model">product.types</field>
        <field name="arch" type="xml">
        <form string="Product Types Form">
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                        <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                    </button>
                </div>
                <group>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <!-- <field name="sequence"/> -->
                        
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </group>
            </sheet>

        </form>
        </field>
    </record>   

    <record id="product_template_search_view_ext" model="ir.ui.view">
        <field name="name">product.template.search.ext</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="filter_domain">
                    ['|', '|', '|', '|', 
                    ('default_code', 'ilike', self), ('product_variant_ids.default_code', 'ilike', self),('name', 'ilike', self), ('barcode', 'ilike', self), ('product_reference_no', 'ilike', self)]
                </attribute>
            </xpath>

            <field name="name" position="before">
                <field name="product_reference_no"/>
            </field>

        </field>
    </record>

    <record id="product_product_tree_view_ext" model="ir.ui.view">
            <field name="name">product.product.list.ext</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_product_tree_view"/>
            <field name="arch" type="xml">
                <field name="default_code" position="after">
                    <field name="product_reference_no"/>
                </field>
            </field>
    </record>

    <record id="product_types_action" model="ir.actions.act_window">
        <field name="name">Product Types</field>
        <field name="res_model">product.types</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem id="product_types_root_menu"
        name="Product Types"
        action="product_types_action"
        parent="stock.menu_stock_inventory_control"
    />

</odoo>
