<odoo>

    <record id="mrp_production_workorder_form_view_inherit_ext" model="ir.ui.view">
        <field name="name">mrp.production.workorder.form.view.inherit.ext</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_form_view_inherit"/>
        <field name="arch" type="xml">
            <!-- Group [1] Add-ons -->
            <xpath expr="//sheet/group[1]/group[1]" position="inside">
                <field name="charge_id"/>
                <field name="user_id"/>
                <field name="operation_notes"/>

            </xpath>

            <!-- Group [2] Add-ons -->
            <xpath expr="//sheet/group[1]/group[2]" position="inside">
                <field name="operation_files" widget="many2many_binary" nolabel="1"/>

            </xpath>


            <!-- Operation type field-->
            <xpath expr="//sheet/group/group/field[@name='name']" position="replace">
                
                <!-- 1. Ваше поле для выбора типа операции -->
                <field name="operation_type_id" 
                    string="Operation" 
                    readonly="state in ['cancel', 'done']"
                    options="{'no_create': False, 'no_edit': False}"/>
                
                <!-- 2. Скрытое системное поле name (обязательно должно быть во view) -->
                <field name="name" invisible="1" force_save='1'/>
                <field name="operation_type_code" invisible="1"/>
                

            </xpath>

            <!-- Add "Print Report" button -->
            <xpath expr="//header" position="inside">
                <button name="action_print_workorder_report" string="Print Report" type="object"/>
            </xpath>

            <!-- Add operation-specific parameters fields -->
            <xpath expr="//notebook/page[1]" position="before">
                <!-- Forging Operation Parameters -->
                <page string="Operation Parameters" 
                    invisible="operation_type_code != 'forging'"
                    id="group_forging_operation_parameters">
                    
                    <field name="forging_operation_params_id" nolabel="1">
                        <list>
                            <field name="order_dimensions"/>
                            <field name="start_temperature"/>
                            <field name="end_temperature"/>

                        </list>

                        <form string="Forging Parameters">
                            <sheet>
                                <group>
                                    <group>
                                        <!-- <field name="sequence" invisible="1"/> -->
                                        <field name="order_dimensions"/>
                                        <field name="lubtication"/>

                                    </group>
                                    <group>
                                        <field name="start_temperature"/>
                                        <field name="end_temperature"/>
                                    </group>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>


            </xpath>



            <!-- Add operation-specific pages in notebook -->
            <xpath expr="//notebook" position="inside">
                
                <!-- Cutting Operations Page -->
                <page string="Operation Report" 
                    invisible="operation_type_code != 'cutting'"
                    id="page_cutting_operations">
                    <field name="cutting_operation_ids" nolabel="1">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="equipment_id"/>
                            <field name="performer_id"/>
                            <field name="responsible_id"/>
                            <field name="ksb_form_no"/>
                            <field name="income_material_weight"/>
                            <field name="outcome_material_weight"/>
                            <field name="income_material_crosssection"/>
                            <field name="outcome_material_crosssection"/>
                            <field name="income_material_length"/>
                            <field name="outcome_material_length"/>
                            <field name="quality_approval"/>

                        </list>

                        <form string="Cutting Operation">
                            <sheet>
                                <group>
                                    <group>
                                        <!-- <field name="sequence"/> -->
                                        <field name="name"/>
                                        <field name="equipment_id"/>
                                        <field name="performer_id"/>
                                        <field name="responsible_id"/>
                                        <field name="ksb_form_no"/>
                                        <field name="workorder_id"/>
                                        <!-- <field name="layout_json" widget="layout_editor"/> -->
                                        
                                    </group>
                                    <group>
                                        <field name="income_material_weight"/>
                                        <field name="outcome_material_weight"/>
                                        <field name="income_material_crosssection"/>
                                        <field name="outcome_material_crosssection"/>
                                        <field name="income_material_length"/>
                                        <field name="outcome_material_length"/>
                                        <field name="quality_approval"/>
                                        
                                    </group>
                                </group>
                        
                                <group string="Notes" colspan="2">
                                    <field name="notes" nolabel="1" placeholder="Additional notes..." colspan="2"/>
                                </group>

                            </sheet>
                        </form>
                    </field>
                </page>

                
                <!-- Heating Operations Page -->
                <page string="Operation Report" 
                      invisible="operation_type_code != 'heating'"
                      id="page_heating_operations">
                    <field name="heating_operation_ids" nolabel="1">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="equipment_id"/>
                            <field name="recipe_name"/>
                            <field name="charge_id"/>
                            <field name="heating_date"/>
                            <field name="performer_id"/>
                            <field name="responsible_id"/>
                            <field name="hardness_target_low"/>
                            <field name="hardness_target_high"/>
                            <field name="hardness_UOM"/>
                            <field name="hardness_measured"/>
                            <field name="quality_approval"/>

                        </list>
                        <form string="Heating Operation">
                            <sheet>
                                <group>
                                    <group>
                                        <!-- <field name="sequence"/> -->
                                        <field name="name"/>
                                        <field name="equipment_id"/>
                                        <field name="recipe_name"/>
                                        <field name="workorder_id"/>
                                        <field name="charge_id"/>
                                        <field name="heating_date"/>
                                    </group>
                                    <group>
                                        <field name="performer_id"/>
                                        <field name="responsible_id"/>
                                        <field name="resposible_quality_id"/>
                                        <field name="approver_quality_id"/>
                                        <field name="measurement_device_id"/>
                                        <field name="ksb_form_no"/>
                                        <field name="hardness_target_low"/>
                                        <field name="hardness_target_high"/>
                                        <field name="hardness_UOM"/>
                                        <field name="hardness_measured"/>
                                        <field name="quality_approval"/>

                                    </group>
                                </group>
                                <group string="Notes" colspan="2">
                                    <field name="notes" nolabel="1" placeholder="Additional notes..." colspan="2"/>
                                </group>

                                <!-- <group string="Components" colspan="2">
                                    <field name="charge_component_ids" widget="many2many" readonly="1" nolabel="1"/>

                                </group> -->

                                <group string="Layout" colspan="2">


                                    <field name="svg_builder_id" nolabel="1" readonly="1" invisible="1"/>

                                    <field name="svg_preview" widget="html" readonly="1" nolabel="1"/>

                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>

                <!-- Grinding Operations Page -->
                <page string="Operation Report" 
                      invisible="operation_type_code != 'grinding'"
                      id="page_grinding_operations">
                    <field name="grinding_operation_ids" nolabel="1">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="equipment_id"/>
                            <!-- <field name="recipe_name"/> -->
                            <!-- <field name="charge_id"/> -->
                            <field name="operation_date"/>
                            <field name="performer_id"/>
                            <field name="responsible_id"/>
                            <field name="resposible_quality_id"/>
                            <field name="quality_approval"/>

                        </list>
                        <form string="Grinding Operation">
                            <sheet>
                                <group>
                                    <group>
                                        <!-- <field name="sequence"/> -->
                                        <field name="name"/>
                                        <field name="equipment_id"/>
                                        <!-- <field name="recipe_name"/> -->
                                        <field name="workorder_id"/>
                                        <!-- <field name="charge_id"/> -->
                                        <field name="operation_date"/>
                                    </group>
                                    <group>
                                        <field name="performer_id"/>
                                        <field name="responsible_id"/>
                                        <field name="resposible_quality_id"/>
                                        <field name="ksb_form_no"/>
                                        <field name="quality_approval"/>
                                        

                                    </group>
                                </group>
                                <group string="Tools" colspan="2">
                                    <field name="tools_ids" nolabel="1" placeholder="Used tools..." colspan="2"/>
                                </group>
                                <group string="Notes" colspan="2">
                                    <field name="notes" nolabel="1" placeholder="Additional notes..." colspan="2"/>
                                </group>

                            </sheet>
                        </form>
                    </field>
                </page>

                <!-- Forging Operations Page -->
                <page string="Operation Report" 
                      invisible="operation_type_code != 'forging'"
                      id="page_forging_operations">
                    <field name="forging_operation_ids" nolabel="1">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="equipment_id"/>
                            <!-- <field name="recipe_name"/> -->
                            <!-- <field name="charge_id"/> -->
                            <field name="operation_date"/>
                            <field name="performer_id"/>
                            <field name="responsible_id"/>
                            <field name="resposible_quality_id"/>
                            <field name="quality_approval"/>

                        </list>
                        <form string="Forging Operation">
                            <sheet>
                                <group>
                                    <group>
                                        <!-- <field name="sequence"/> -->
                                        <field name="name"/>
                                        <field name="equipment_id"/>
                                        <!-- <field name="recipe_name"/> -->
                                        <field name="workorder_id"/>
                                        <!-- <field name="charge_id"/> -->
                                        <field name="performer_id"/>
                                        <field name="responsible_id"/>
                                        <field name="resposible_quality_id"/>
                                    </group>
                                    <group>
                                        <field name="operation_date"/>
                                        <field name="step_dimensions"/>
                                        <field name="start_temperature"/>
                                        <field name="end_temperature"/>

                                        <field name="ksb_form_no"/>
                                        <field name="quality_approval"/>

                                    </group>
                                </group>
                                <group string="Tools" colspan="2">
                                    <field name="tools_ids" nolabel="1" placeholder="Used tools..." colspan="2"/>
                                </group>
                                <group string="Notes" colspan="2">
                                    <field name="notes" nolabel="1" placeholder="Additional notes..." colspan="2"/>
                                </group>

                            </sheet>
                        </form>
                    </field>
                </page>

                <!-- Machining Operations Page -->
                <page string="Operation Report" 
                      invisible="operation_type_code != 'machining'"
                      id="page_machining_operations">
                    <field name="machining_operation_ids" nolabel="1">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="equipment_id"/>
                            <!-- <field name="recipe_name"/> -->
                            <!-- <field name="charge_id"/> -->
                            <field name="start_date_time"/>
                            <field name="end_date_time"/>
                            <field name="performer_id"/>
                            <field name="responsible_id"/>
                            <field name="resposible_quality_id"/>
                            <field name="quality_approval"/>

                        </list>
                        <form string="Machining Operation">
                            <sheet>
                                <group>
                                    <group string="Production">
                                        <!-- <field name="sequence"/> -->
                                        <field name="name"/>
                                        <field name="equipment_id"/>
                                        <!-- <field name="recipe_name"/> -->
                                        <field name="workorder_id" invisible="1"/>
                                        <!-- <field name="charge_id"/> -->
                                        <field name="performer_id"/>
                                        <field name="responsible_id"/>
                                        <field name="start_date_time"/>
                                        <field name="end_date_time"/>
                                        <field name="income_material_crossection" string='Income size'/>
                                        <field name="outcome_material_crossection" string='Final size'/>
                                        <field name="income_material_length" string='Income lenght'/>
                                        <field name="outcome_material_length" string='Final lenght'/>

                                        <!-- <div string="Used Tools">
                                            <field name="tools_ids" nolabel="1" placeholder="Used tools..." colspan="2"/>
                                        </div> -->

                                    </group>
                                    <group string="Quality">
                                        <field name="resposible_quality_id"/>
                                        <field name="approver_quality_id"/>
                                        <field name="desired_material_crossection"/>
                                        <field name="measured_material_crossection"/>

                                        <field name="ksb_form_no"/>
                                        <field name="quality_approval"/>

                                        <!-- <div string="Measurement devices">
                                            <field name="measurement_device_ids" nolabel="1" placeholder="Used tools..." colspan="2"/>
                                        </div> -->

                                    </group>

                                </group>
                                <group colspan="2">
                                    <group string="Tools" colspan="1">
                                        <field name="tools_ids" nolabel="1" placeholder="Used tools..." colspan="2"/>
                                    </group>
                                    <group string="Measurement devices" colspan="1">
                                        <field name="measurement_device_ids" nolabel="1" placeholder="Used tools..." colspan="2"/>
                                    </group>
                                </group>

                                <group string="Notes" colspan="2">
                                    <field name="notes" nolabel="1" placeholder="Additional notes..." colspan="2"/>
                                </group>

                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>


    <!-- #Name Inheritance to add Many2one field to mrp.workorder -->
    <!-- Gemini # Pro -->

    <record id="mrp_production_workorder_tree_editable_view_custom_types" model="ir.ui.view">
        <field name="name">mrp.production.work.order.list.editable.custom.types</field>
        <field name="model">mrp.workorder</field>
        <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_editable_view"/>
        <field name="arch" type="xml">
            
            <!-- Operation from the list -->
            <xpath expr="//field[@name='name']" position="replace">
                
                <!-- 
                    1. Вставляем наше поле-ссылку.
                    По умолчанию Many2one позволяет "Создать и редактировать".
                    Если хотите запретить создание на лету, добавьте options="{'no_create': True}"
                -->
                <field name="operation_type_id" 
                       string="Operation" 
                       readonly="state in ['cancel', 'done']"
                       widget="many2one"/>

                <!-- 
                    2. Оригинальное поле name оставляем, но делаем невидимым (column_invisible).
                    Оно заполнится автоматически благодаря методу _onchange в Python.
                    force_save="1" гарантирует, что значение запишется в базу, даже если поле невидимо.
                -->
                <field name="name" column_invisible="True" force_save="1"/>
                <field name="user_id" optional="show"/>
                
            </xpath>


            <xpath expr="//field[@name='product_id']" position="replace">
                <field name="product_id" optional="show"/>
                <field name="product_reference_no" optional="hide"/>
                <field name="component_id" optional="show"/>
                <field name="component_reference_no" optional="hide"/>

            </xpath>

            

        </field>
    </record>
</odoo>
