<odoo>
  <data>
    <record id="operation_charge_list_view" model="ir.ui.view">
        <field name="name">operation.charge.list.view</field>
        <field name="model">operation.charge</field>
        <field name="arch" type="xml">
        <list string="Operation Charges">
            <field name="id"/>
            <field name="name"/>
            <field name="operation_type_id"/>
            <field name="workorder_list" widget="many2many_tags"/>
            <field name="mo_ids" widget="many2many_tags"/>
            <field name="mo_component_ids" widget="many2many_tags"/>
            <field name="mo_product_ids" widget="many2many_tags"/>


        </list>
        </field>
    </record>

    

    <record id="operation_charge_form_view" model="ir.ui.view">
        <field name="name">operation.charge.form.view</field>
        <field name="model">operation.charge</field>
        <field name="arch" type="xml">
            <form string="Operation Charge Form">
                <sheet>
                    <group>
                        <group string="Charge Info">
                            <field name="name"/>
                            <field name="operation_type_id"/>
                        </group>

                        <group string="Filters">
                            <field name="selected_mo_ids" widget="many2many_tags"/>
                            <field name="selected_product_ids" widget="many2many_tags"/>
                            <field name="selected_component_ids" widget="many2many_tags"/>

                            <separator string="Add Workorder" colspan="2"/>
                            
                            <field name="workorder_id" string="Add Workorder" domain="computed_wo_domain" nolabel='1'/>
                        </group>
                    </group>

                    <group string="Workorder List" colspan="2">    
                        <field name="workorder_list" create="true" nolabel='1'/>

                    </group>

                    <group string="Components">
                        <field name="mo_component_ids" widget="many2many" readonly="1" nolabel="1"/>

                    </group>
                        
                    <group string="Layout" colspan="2">
                        <!-- Строка управления созданием SVG-->
                        <div class="d-flex align-items-center mb-3" invisible="svg_builder_id != False">
                            <label for="template_svg_id" string="Template:" class="me-2"/>
                            <div style="min-width: 200px;" class="me-2">
                                <field name="template_svg_id" nolabel="1" options="{'no_create': True}"/>
                            </div>
                            <button name="action_create_svg" type="object" string="New" class="btn-primary" invisible="name == False"/>
                        </div>

                        <!-- Строка управления существующим SVG -->
                        <div class="o_row mb-3" invisible="svg_builder_id == False">
                            <button name="action_open_svg"
                                    type="object"
                                    string="Edit"
                                    class="btn-primary"
                                    icon="fa-pencil"/>
                            
                            <button name="action_delete_svg"
                                    type="object"
                                    string="Remove"
                                    class="btn-primary"
                                    confirm="This will permanently delete the SVG. Continue?"
                                    icon="fa-trash"/>
                        </div>

                        <!-- Скрытые технические поля SVG-->
                        <field name="svg_builder_id" invisible="1"/>

                        <!-- Превью SVG-->
                        <field name="svg_preview" 
                            widget="html" 
                            readonly="1" 
                            nolabel="1" 
                            invisible="svg_builder_id == False"
                            class="border rounded bg-light p-2"/>
                    </group>
                    
                </sheet>
            </form>
        </field>
    </record>

    

    <record id="operation_types_list_view" model="ir.ui.view">
        <field name="name">operation.types.list.view</field>
        <field name="model">operation.types</field>
        <field name="arch" type="xml">
        <list string="Operation Types">
            <field name="id"/>
            <field name="sequence" widget="handle"/>
            <field name="name"/>
            <field name="code"/>
            <field name="workcenter_id"/>
            <field name="equipment_id"/>
            <field name="model_name" invisible="1"/>
            <field name="active"/>

        </list>
        </field>
    </record>

    <record id="operation_types_form_view" model="ir.ui.view">
        <field name="name">operation.types.form.view</field>
        <field name="model">operation.types</field>
        <field name="arch" type="xml">
        <form string="Operation Types Form">
            <sheet>
                <div class="oe_button_box" name="button_box">
                    <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                        <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                    </button>
                </div>
                <group>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="model_name" invisible="1"/>
                        <field name="sequence"/>
                        
                    </group>
                    <group>
                        <field name="workcenter_id"/>
                        <field name="equipment_id"/>
                        <field name="color" widget="color_picker"/>
                        <field name="properties_definition" widget="properties_definition" nolabel="1" readonly="0"/>
                    </group>
                </group>
                <group>
                    <group string="Operation Notes Template" colspan="2">
                        
                        <field name="operation_notes_template" placeholder="Enter operation notes template..." colspan="2" nolabel="1"/>
                        
                    </group>
                </group>
                <group>
                    <group string="Description" colspan="2">
                        <field name="description" placeholder="Describe this operation type..." colspan="2" nolabel="1" />
                        
                    </group>
                </group>

                 
                
            </sheet>

        </form>
        </field>
    </record>   


    
    <record id="operation_charge_action" model="ir.actions.act_window">
        <field name="name">Operation Charges</field>
        <field name="res_model">operation.charge</field>
        <field name="view_mode">list,form</field>
    </record>


    <record id="operation_types_action" model="ir.actions.act_window">
        <field name="name">Operation Types</field>
        <field name="res_model">operation.types</field>
        <field name="view_mode">list,form</field>
    </record>


    <menuitem id="manufacturing_extension_root_menu"
        name="Operations"
        parent="mrp.menu_mrp_manufacturing"
    />
    
    <menuitem id="manufacturing_extension_operation_charge_menu"
        action="operation_charge_action"
        name="Operation Charges"
        parent="manufacturing_extension_root_menu"
    />

    <menuitem id="manufacturing_extension_operation_types_menu"
        action="operation_types_action"
        name="Operation Types"
        parent="manufacturing_extension_root_menu"
    />

  </data>

</odoo>