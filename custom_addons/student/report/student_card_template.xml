<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="student_card_pdf_template_report">
        <t t-call="web.basic_layout">                            
            <div class="page">
                <t t-foreach="docs" t-as="student">
                    <div class="col-md-6">                        
                        <table style="width:240pt; height:150pt; border:1pt solid #000; border-collapse:separate; border-radius:8pt; margin:5pt;">
                                <tr>
                                    <td>
                                        <!-- <img t-if="student.student_img"
                                            style="max-width:80px; max-height:80px;"
                                            t-att-src="image_data_uri(student.student_img)"
                                            alt="Student image"/> -->

                                        <!-- <img t-att-src="'/report/barcode/QR/%s' % student.name"
                                            width="150pt" height="150pt;"
                                            alt="QR Code"/> -->

                                        <!-- <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' %('QR', student.name, 150, 150)" alt="QR-code"/> -->

                                        <div t-field="student.name" 
                                             t-options="{'widget':'barcode', 'symbology':'QR', 'width':150, 'height':150, 'img_style':'width:100%;height:100%;'}"/>



                                    </td>
                                    <td>
                                        <table>
                                            <tr>
                                                <th>
                                                    <t t-esc="student.name"/>
                                                </th>
                                                <th>
                                                    <t t-esc="student.school_id.name"/>
                                                </th>
                                                <th>
                                                    <t t-esc="student.roll_number"/>
                                                </th>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                        </table>
                    </div>
                </t>
            </div>           
        </t>
    </template>

    <record id="school_student_profile_card_report" model="ir.actions.report">
        <field name="name">Student Card</field>
        <field name="model">wb.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">student.student_card_pdf_template_report</field>
        <field name="report_file">student.student_card_pdf_template_report</field>
        <field name="print_report_name">'Student-Card'</field>
        <field name="binding_model_id" ref="model_wb_student"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
